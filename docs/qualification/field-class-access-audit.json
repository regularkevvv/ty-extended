      "plugin.py": "set_manifest({'id': 'research.fields', 'name': 'Class field access parity', 'version': '0.0.1', 'protocol-version': {'major': 0, 'minor': 7}, 'ty-compatibility': {'requirement': '>=0.86.0'}, 'runtime': {'kind': 'monty', 'artifact': 'plugin.py'}, 'capabilities': {'class-transform': True}, 'claims': {'classes': [{'kind': 'exact', 'qualified-name': 'demo.A'}, {'kind': 'exact', 'qualified-name': 'demo.B'}, {'kind': 'exact', 'qualified-name': 'demo.Absent'}, {'kind': 'exact', 'qualified-name': 'demo.Declared'}, {'kind': 'exact', 'qualified-name': 'demo.Property'}, {'kind': 'exact', 'qualified-name': 'demo.DataDescriptor'}]}})\n\n@on_class_transform\ndef transform(request):\n    return class_patch(fields=[field('x', type_annotation('str'), instance_set_type=type_annotation('str'), mode='replace-existing', descriptor=member_descriptor(type_annotation('str'), instance_set_type=type_annotation('str')))])\n",
      "plugin.plugin.json": "{\"id\": \"research.fields\", \"name\": \"Class field access parity\", \"version\": \"0.0.1\", \"protocol-version\": {\"major\": 0, \"minor\": 7}, \"ty-compatibility\": {\"requirement\": \">=0.86.0\"}, \"runtime\": {\"kind\": \"monty\", \"artifact\": \"plugin.py\"}, \"capabilities\": {\"class-transform\": true}, \"claims\": {\"classes\": [{\"kind\": \"exact\", \"qualified-name\": \"demo.A\"}, {\"kind\": \"exact\", \"qualified-name\": \"demo.B\"}, {\"kind\": \"exact\", \"qualified-name\": \"demo.Absent\"}, {\"kind\": \"exact\", \"qualified-name\": \"demo.Declared\"}, {\"kind\": \"exact\", \"qualified-name\": \"demo.Property\"}, {\"kind\": \"exact\", \"qualified-name\": \"demo.DataDescriptor\"}]}}",
      "project/demo.py": "from typing import reveal_type\n\nclass A:\n    x = 1\nclass B:\n    x = 2\nclass Absent:\n    pass\nclass Declared:\n    x: int\nclass Property:\n    @property\n    def x(self) -> int: return 1\nclass Descriptor:\n    def __get__(self, instance: object, owner: type | None = None) -> int: return 1\nclass DataDescriptor:\n    x = Descriptor()\n\nreveal_type(A.x)\nreveal_type(A().x)\nreveal_type(B.x)\nreveal_type(B().x)\nreveal_type(Absent.x)\nreveal_type(Absent().x)\nreveal_type(Declared.x)\nreveal_type(Declared().x)\nreveal_type(Property.x)\nreveal_type(Property().x)\nreveal_type(DataDescriptor.x)\nreveal_type(DataDescriptor().x)\n",
